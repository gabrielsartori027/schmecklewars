# ── AI (server only) ─────────────────────────────────────────────────────────
# Used ONLY by /api/cron/ingest. Without a key the cron answers { skipped: "no-key" }.
ANTHROPIC_API_KEY=
# Latest Sonnet at the time of writing (verify at https://platform.claude.com/docs/en/models/overview)
ANTHROPIC_MODEL=claude-sonnet-5
# Web searches per ingest run (cost: US$10 per 1 000 searches). 2 is the launch default.
ANTHROPIC_WEB_SEARCH_MAX_USES=2

# ── Infra (server only) ──────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel sends "Authorization: Bearer <CRON_SECRET>" with every cron invocation.
CRON_SECRET=

# ── Chain ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=4663
# Recommended: Alchemy. Fallback: https://rpc.mainnet.chain.robinhood.com (rate-limited)
RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/<ALCHEMY_KEY>
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Phase 1: verification of the final leg of aid drops on Ethereum mainnet
ETH_MAINNET_RPC_URL=
# Stablecoin tracked in the War Chest. USDG (Paxos Global Dollar) is the native stable
# of Robinhood Chain — address from https://docs.robinhood.com/chain/contracts. Confirm on Blockscout.
NEXT_PUBLIC_STABLE_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_STABLE_SYMBOL=USDG
NEXT_PUBLIC_STABLE_DECIMALS=6

# ── Token ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TOKEN_CA=
NEXT_PUBLIC_TOKEN_SYMBOL=$CHMCO
NEXT_PUBLIC_TOKEN_NAME=Schmeckle Coin
# Token page on the launchpad (Pons v2: https://www.ponsfamily.com/launchpad/...)
NEXT_PUBLIC_LAUNCHPAD_URL=
NEXT_PUBLIC_LAUNCHPAD_NAME=Pons
# Optional. If empty and a CA is set, the site links to
# https://app.uniswap.org/explore/tokens/robinhood/<CA>
NEXT_PUBLIC_SWAP_URL=
NEXT_PUBLIC_SITE_URL=https://schmecklewars.com

# ── War Chest ────────────────────────────────────────────────────────────────
# Safe{Wallet} 2-of-3 on Robinhood Chain — the ONLY address called "War Chest".
NEXT_PUBLIC_WAR_CHEST_ADDRESS=
# EOA that created the token on the launchpad (where the creator share accrues / is claimed).
NEXT_PUBLIC_CREATOR_WALLET=
NEXT_PUBLIC_OPS_ADDRESS=
NEXT_PUBLIC_RESERVE_ADDRESS=
# ISO UTC timestamp of the launch = start of Epoch 1, e.g. 2026-09-15T15:00:00Z
GENESIS_TS=
EPOCH_DAYS=14
# Phase 1 — only for 0-ETH self-transactions that publish snapshot hashes.
# NEVER the Safe owner key, NEVER the creator wallet key.
PUBLISHER_ADDRESS=
PUBLISHER_PRIVATE_KEY=

# ── Dev ──────────────────────────────────────────────────────────────────────
# Generates FAKE events labelled "SIMULATION" to test the choreography. Forced off on
# Vercel production (VERCEL_ENV=production).
NEXT_PUBLIC_SIMULATION=false
